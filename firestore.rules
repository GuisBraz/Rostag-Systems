rules_version = '2';

// Rostag Systems — quem vê e quem mexe em quê.
// Níveis: adm (criador, tudo liberado) · gerente (vê tudo) · lider (a própria equipe)
//         · analista (a equipe do seu líder) · pendente (sem acesso até ser liberado).
// Equipe = id do líder. Tarefas guardam `equipeId`.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function eu() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function nivel() { return eu().nivel; }
    function ativo() { return logado() && nivel() in ['adm', 'gerente', 'lider', 'analista']; }
    function adm() { return logado() && nivel() == 'adm'; }
    function gerente() { return logado() && nivel() in ['adm', 'gerente']; }   // gerência ou ADM
    function minhaEquipe() {
      return nivel() == 'lider' ? request.auth.uid : (nivel() == 'analista' ? eu().liderId : null);
    }
    function daMinhaEquipe(equipeId) { return ativo() && equipeId != null && equipeId == minhaEquipe(); }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function convite(cod) { return get(/databases/$(database)/documents/convites/$(cod)).data; }

    // ---------------------------------------------------------------- pessoas
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ativo());

      // Conta nova: entra como "pendente" OU, com um convite válido, já no nível do
      // convite — e o mesmo lote precisa marcar o convite como usado por esta conta.
      allow create: if logado() && request.auth.uid == uid && (
        (request.resource.data.nivel == 'pendente' && request.resource.data.liderId == null
          && !('convite' in request.resource.data))
        || (
          request.resource.data.convite is string
          && convite(request.resource.data.convite).usado == false
          && convite(request.resource.data.convite).expiraEm > request.time.toMillis()
          && request.resource.data.nivel == convite(request.resource.data.convite).nivel
          && request.resource.data.liderId == convite(request.resource.data.convite).liderId
          && getAfter(/databases/$(database)/documents/convites/$(request.resource.data.convite)).data.usadoPor == request.auth.uid
        ));

      // ADM muda qualquer um. Gerência muda só líderes, analistas e pendentes, e não cria gerentes.
      // Cada um pode mudar o próprio nome.
      allow update: if adm()
        || (gerente() && request.auth.uid != uid
            && resource.data.nivel in ['lider', 'analista', 'pendente']
            && request.resource.data.nivel in ['lider', 'analista', 'pendente'])
        || (logado() && request.auth.uid == uid && mudou().hasOnly(['nome']));
      allow delete: if adm() && request.auth.uid != uid;
    }

    // --------------------------------------------------------------- convites
    match /convites/{cod} {
      // Quem tem o link (código aleatório) pode ler aquele convite, mesmo sem login;
      // listar todos, só a gerência.
      allow get: if true;
      allow list: if gerente();
      allow create: if gerente()
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.usado == false
        && request.resource.data.expiraEm is number
        && (request.resource.data.nivel in ['lider', 'analista'] || (adm() && request.resource.data.nivel == 'gerente'))
        && (request.resource.data.nivel != 'analista' || request.resource.data.liderId is string);
      // Usar o convite: só uma vez, pela conta que está sendo criada com ele.
      allow update: if logado() && resource.data.usado == false
        && resource.data.expiraEm > request.time.toMillis()
        && mudou().hasOnly(['usado', 'usadoPor', 'usadoEm'])
        && request.resource.data.usado == true
        && request.resource.data.usadoPor == request.auth.uid
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.convite == cod;
      allow delete: if gerente();
    }

    // --------------------------------------------------------------- projetos
    match /projetos/{id} {
      allow read: if ativo();
      // Projeto = escopo de uma commessa (AAAA-NNN, pode repetir), com líder responsável.
      function projetoValido() {
        return request.resource.data.nome is string && request.resource.data.nome.size() > 0
          && request.resource.data.commessa is string && request.resource.data.commessa.matches('^[0-9]{4}-[0-9]{3}$')
          && request.resource.data.liderId is string
          && request.resource.data.analistaIds is list;
      }
      allow create: if ativo() && nivel() in ['adm', 'gerente', 'lider']
        && request.resource.data.criadoPor == request.auth.uid
        && projetoValido();
      allow update: if ativo() && nivel() in ['adm', 'gerente', 'lider']
        && !mudou().hasAny(['criadoPor', 'criadoEm'])
        && projetoValido();
      allow delete: if gerente();
    }

    // ---------------------------------------------------------------- tarefas
    match /tarefas/{id} {
      allow read: if gerente() || daMinhaEquipe(resource.data.equipeId);

      allow create: if (gerente() || daMinhaEquipe(request.resource.data.equipeId))
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0
        && request.resource.data.responsavelId is string
        && request.resource.data.status in ['afazer', 'andamento', 'concluida'];

      allow update: if (gerente() || (daMinhaEquipe(resource.data.equipeId) && !mudou().hasAny(['equipeId'])))
        && (adm() || !mudou().hasAny(['criadoPor', 'criadoEm']))
        && request.resource.data.status in ['afazer', 'andamento', 'concluida'];

      allow delete: if gerente() || (nivel() == 'lider' && daMinhaEquipe(resource.data.equipeId));
    }
  }
}
